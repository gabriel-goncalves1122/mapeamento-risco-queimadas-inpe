{
  "type": "index_parallel",
  "spec": {
    "ioConfig": {
      "type": "index_parallel",
      "inputSource": {
        "type": "local",
        "baseDir": "/opt/data/processed/dimensions",
        "filter": "dim_ons_sistemas_isolados.csv"
      },
      "inputFormat": {
        "type": "csv",
        "findColumnsFromHeader": true
      }
    },
    "tuningConfig": {
      "type": "index_parallel",
      "maxRowsPerSegment": 5000000
    },
    "dataSchema": {
      "dataSource": "dim_ons_sistemas_isolados",
      "timestampSpec": {
        "column": "!!!_no_magic_time_column_!!!",
        "missingValue": "2025-01-01T00:00:00.000Z"
      },
      "dimensionsSpec": {
        "dimensions": [
          { "type": "string", "name": "id_sistema_isolado" },

          { "type": "string", "name": "nome_sistema_isolado" },
          { "type": "string", "name": "sistema_isolado_idx" },

          { "type": "string", "name": "estado_sigla" },
          { "type": "string", "name": "estado_sigla_idx" },

          { "type": "string", "name": "regiao_eletrica" },
          { "type": "string", "name": "regiao_eletrica_idx" },

          { "type": "string", "name": "prioridade_sistema_isolado" },
          { "type": "string", "name": "prioridade_sistema_isolado_idx" },

          { "type": "double", "name": "latitude" },
          { "type": "double", "name": "longitude" },

          { "type": "string", "name": "sistema_isolado_point" },
          { "type": "string", "name": "geometria_wkt" }
        ]
      },
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "ALL",
        "queryGranularity": "NONE",
        "rollup": false
      }
    }
  }
}