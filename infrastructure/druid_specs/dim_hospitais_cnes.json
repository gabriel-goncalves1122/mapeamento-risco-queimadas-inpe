{
  "type": "index_parallel",
  "spec": {
    "ioConfig": {
      "type": "index_parallel",
      "inputSource": {
        "type": "local",
        "baseDir": "/opt/data/processed/dimensions",
        "filter": "dim_hospitais_cnes.csv"
      },
      "inputFormat": {
        "type": "csv",
        "findColumnsFromHeader": true
      }
    },
    "tuningConfig": {
      "type": "index_parallel",
      "maxRowsPerSegment": 5000000
    },
    "dataSchema": {
      "dataSource": "dim_hospitais_cnes",
      "timestampSpec": {
        "column": "!!!_no_magic_time_column_!!!",
        "missingValue": "2025-01-01T00:00:00.000Z"
      },
      "dimensionsSpec": {
        "dimensions": [
          { "type": "string", "name": "codigo_cnes" },

          { "type": "string", "name": "nome_hospital" },

          { "type": "string", "name": "tipo_unidade" },

          { "type": "string", "name": "categoria_unidade" },

          { "type": "string", "name": "tipo_unidade_idx" },

          { "type": "string", "name": "tipo_unidade_critica" },

          { "type": "string", "name": "categoria_atendimento" },

          { "type": "string", "name": "funciona_24h" },
          { "type": "string", "name": "funciona_24h_idx" },

          { "type": "string", "name": "codigo_ibge" },

          { "type": "string", "name": "municipios_nome" },

          { "type": "string", "name": "estado_sigla" },

          { "type": "double", "name": "latitude" },
          { "type": "double", "name": "longitude" },

          { "type": "string", "name": "hospital_point" }
        ]
      },
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "ALL",
        "queryGranularity": "NONE",
        "rollup": false
      }
    }
  }
}