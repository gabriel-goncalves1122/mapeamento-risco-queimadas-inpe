{
  "type": "index_parallel",
  "spec": {
    "ioConfig": {
      "type": "index_parallel",
      "inputSource": {
        "type": "local",
        "baseDir": "/opt/data/processed/dimensions",
        "filter": "dim_ons_subestacoes.csv"
      },
      "inputFormat": {
        "type": "csv",
        "findColumnsFromHeader": true
      }
    },
    "tuningConfig": {
      "type": "index_parallel",
      "maxRowsPerSegment": 5000000
    },
    "dataSchema": {
      "dataSource": "dim_ons_subestacoes",
      "timestampSpec": {
        "column": "!!!_no_magic_time_column_!!!",
        "missingValue": "2025-01-01T00:00:00.000Z"
      },
      "dimensionsSpec": {
        "dimensions": [
          { "type": "string", "name": "id_subestacao" },
          { "type": "string", "name": "nome_subestacao" },
          { "type": "double", "name": "capacidade_mw" },
          { "type": "string", "name": "classe_capacidade" },
          { "type": "string", "name": "criticidade_subestacao" },
          { "type": "string", "name": "agente_responsavel" },
          { "type": "string", "name": "codigo_ibge" },
          { "type": "double", "name": "latitude" },
          { "type": "double", "name": "longitude" },
          { "type": "string", "name": "path_json" }
        ]
      },
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "ALL",
        "queryGranularity": "NONE",
        "rollup": false
      }
    }
  }
}
