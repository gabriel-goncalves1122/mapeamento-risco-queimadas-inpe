{
  "type": "index_parallel",
  "spec": {
    "ioConfig": {
      "type": "index_parallel",
      "inputSource": {
        "type": "local",
        "baseDir": "/opt/data/processed/dimensions",
        "filter": "dim_terras_indigenas.csv"
      },
      "inputFormat": {
        "type": "csv",
        "findColumnsFromHeader": true
      }
    },
    "tuningConfig": {
      "type": "index_parallel",
      "maxRowsPerSegment": 5000000
    },
    "dataSchema": {
      "dataSource": "dim_terras_indigenas",
      "timestampSpec": {
        "column": "!!!_no_magic_time_column_!!!",
        "missingValue": "2025-01-01T00:00:00.000Z"
      },
      "dimensionsSpec": {
        "dimensions": [
          { "type": "string", "name": "codigo_ti" },

          { "type": "string", "name": "nome_terra_indigena" },

          { "type": "string", "name": "etnia" },
          { "type": "string", "name": "etnia_idx" },

          { "type": "string", "name": "municipios" },

          { "type": "string", "name": "estado_sigla" },
          { "type": "string", "name": "estado_sigla_idx" },

          { "type": "double", "name": "area_hectares" },

          { "type": "string", "name": "classe_area_ti" },
          { "type": "string", "name": "classe_area_ti_idx" },

          { "type": "string", "name": "estagio_regularizacao" },
          { "type": "string", "name": "estagio_regularizacao_idx" },

          { "type": "string", "name": "modalidade" },
          { "type": "string", "name": "modalidade_idx" },

          { "type": "string", "name": "coordenacao_regional" },
          { "type": "string", "name": "coordenacao_regional_idx" },

          { "type": "string", "name": "em_faixa_fronteira" },
          { "type": "string", "name": "faixa_fronteira_idx" },

          { "type": "string", "name": "prioridade_funai" },
          { "type": "string", "name": "prioridade_funai_idx" },

          { "type": "double", "name": "lat_centroide" },
          { "type": "double", "name": "lon_centroide" },

          { "type": "string", "name": "terra_indigena_point" },
          { "type": "string", "name": "geometria_wkt" }
        ]
      },
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "ALL",
        "queryGranularity": "NONE",
        "rollup": false
      }
    }
  }
}