{
  "type": "kafka",
  "spec": {
    "ioConfig": {
      "type": "kafka",
      "consumerProperties": {
        "bootstrap.servers": "kafka:9092"
      },
      "topic": "streaming_focos_incendio",
      "inputFormat": {
        "type": "json"
      },
      "useEarliestOffset": true,
      "taskDuration": "PT1H",
      "completionTimeout": "PT30M",
      "replicas": 1,
      "taskCount": 1
    },
    "tuningConfig": {
      "type": "kafka",
      "maxRowsPerSegment": 5000000,
      "workerThreads": 1,
      "maxRowsInMemory": 100000,
      "maxBytesInMemory": 100000000,
      "intermediatePersistPeriod": "PT10M",
      "logParseExceptions": true,
      "maxParseExceptions": 1000,
      "maxSavedParseExceptions": 20
    },
    "dataSchema": {
      "dataSource": "fato_focos_incendio",
      "timestampSpec": {
        "column": "data_hora",
        "format": "yyyy-MM-dd HH:mm:ss"
      },
      "dimensionsSpec": {
        "dimensions": [
          { "type": "string", "name": "pais_origem" },
          { "type": "string", "name": "fk_bioma" },
          { "type": "string", "name": "fk_satelite_sensor" },
          { "type": "string", "name": "fk_municipio" },
          { "type": "string", "name": "fk_municipio_espacial" },
          { "type": "string", "name": "fk_terra_indigena" },
          { "type": "string", "name": "fk_terra_indigena_proxima" },
          { "type": "string", "name": "fk_trecho_rodoviario" },
          { "type": "string", "name": "fk_linha_transmissao" },
          { "type": "string", "name": "fk_subestacao" },
          { "type": "string", "name": "fk_sistema_isolado" },
          { "type": "string", "name": "fk_hospital" },
          { "type": "double", "name": "latitude" },
          { "type": "double", "name": "longitude" },
          { "type": "long", "name": "coordenada_valida" },
          { "type": "string", "name": "foco_point" },
          { "type": "double", "name": "dias_sem_chuva" },
          { "type": "double", "name": "precipitacao_mm" },
          { "type": "double", "name": "risco_fogo_inpe" },
          { "type": "double", "name": "potencia_radiativa_fogo" },
          { "type": "double", "name": "indice_condicao_ambiental" },
          { "type": "double", "name": "indice_queimada_evento" },
          { "type": "double", "name": "distancia_rodovia_km" },
          { "type": "double", "name": "distancia_linha_km" },
          { "type": "double", "name": "distancia_subestacao_km" },
          { "type": "double", "name": "distancia_sistema_isolado_km" },
          { "type": "double", "name": "distancia_hospital_km" },
          { "type": "double", "name": "distancia_terra_indigena_km" },
          { "type": "double", "name": "indice_ameaca_rodovia" },
          { "type": "double", "name": "indice_ameaca_linha" },
          { "type": "double", "name": "indice_ameaca_subestacao" },
          { "type": "double", "name": "indice_ameaca_sistema_isolado" },
          { "type": "double", "name": "indice_pressao_saude" },
          { "type": "double", "name": "indice_pressao_terra_indigena" },
          { "type": "double", "name": "indice_pressao_maxima" }
        ]
      },
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "MONTH",
        "queryGranularity": "NONE",
        "rollup": false
      }
    }
  }
}
