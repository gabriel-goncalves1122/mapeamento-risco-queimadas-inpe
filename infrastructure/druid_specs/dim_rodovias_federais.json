{
  "type": "index_parallel",
  "spec": {
    "ioConfig": {
      "type": "index_parallel",
      "inputSource": {
        "type": "local",
        "baseDir": "/opt/data/processed/dimensions",
        "filter": "dim_rodovias_federais.csv"
      },
      "inputFormat": {
        "type": "csv",
        "findColumnsFromHeader": true
      }
    },
    "tuningConfig": {
      "type": "index_parallel",
      "maxRowsPerSegment": 5000000
    },
    "dataSchema": {
      "dataSource": "dim_rodovias_federais",
      "timestampSpec": {
        "column": "!!!_no_magic_time_column_!!!",
        "missingValue": "2025-01-01T00:00:00.000Z"
      },
      "dimensionsSpec": {
        "dimensions": [
          { "type": "string", "name": "id_trecho_rodoviario" },
          { "type": "string", "name": "codigo_rodovia" },
          { "type": "string", "name": "jurisdicao" },
          { "type": "string", "name": "classe_revestimento" },
          { "type": "string", "name": "tipo_pavimento" },
          { "type": "string", "name": "classe_situacao_fisica" },
          { "type": "string", "name": "classe_status_operacional" },
          { "type": "string", "name": "criticidade_rodovia" },
          { "type": "double", "name": "latitude" },
          { "type": "double", "name": "longitude" },
          { "type": "string", "name": "path_json" }
        ]
      },
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "ALL",
        "queryGranularity": "NONE",
        "rollup": false
      }
    }
  }
}
