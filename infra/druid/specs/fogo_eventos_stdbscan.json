{
  "type": "index_parallel",
  "spec": {
    "ioConfig": {
      "type": "index_parallel",
      "inputSource": {
        "type": "local",
        "baseDir": "/opt/pipelines/gold/data/fatos",
        "filter": "fogo_eventos_stdbscan.csv"
      },
      "inputFormat": {
        "type": "csv",
        "findColumnsFromHeader": true
      }
    },
    "tuningConfig": {
      "type": "index_parallel",
      "maxRowsPerSegment": 5000000,
      "maxRowsInMemory": 100000
    },
    "dataSchema": {
      "dataSource": "fogo_eventos_stdbscan",
      "timestampSpec": {
        "column": "data_inicio",
        "format": "auto"
      },
      "dimensionsSpec": {
        "dimensions": [
          { "type": "string", "name": "fire_event_id" },
          { "type": "string", "name": "data_fim" },
          { "type": "double", "name": "duracao_dias" },
          { "type": "long", "name": "total_focos" },
          { "type": "double", "name": "soma_frp" },
          { "type": "string", "name": "path_json" }
        ]
      },
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "MONTH",
        "queryGranularity": "NONE",
        "rollup": false
      }
    }
  }
}
