# ==========================================
# 1. AMBIENTES VIRTUAIS E CACHE PYTHON
# ==========================================
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.aux
*.bbl
*.blg

# ==========================================
# 2. DADOS MASSIVOS E GEOGRÁFICOS (CRÍTICO)
# ==========================================
# Ignora todo o conteúdo das subpastas de dados
data/geo/*
data/processed/*
data/raw/*
data/results/*

# Ignora extensões de arquivos de dados pesados em qualquer lugar
*.csv
*.xlsx
*.geojson
*.parquet
*.json.gz
*.shp
*.shx
*.dbf
*.prj

# Arquivo de controle de estado
checkpoint_ingestao.txt

# ==========================================
# 3. KAFKA E LOGS
# ==========================================
ApacheKafka/
logs/
*.log
*.out

# ==========================================
# 4. VOLUMES DOCKER (Caso mapeados localmente)
# ==========================================
metadata_data/
middle_var/
historical_var/
broker_var/
coordinator_var/
router_var/
druid_shared/

# ==========================================
# 5. IDEs E SISTEMA OPERACIONAL E OUTROS
# ==========================================
.vscode/
.idea/
.DS_Store
Thumbs.db
~$*
.env
/backups/

# Backups/exports antigos do Superset devem ir para archive/legacy.
infrastructure/superset/backups/
infrastructure/superset/exports/*
!infrastructure/superset/exports/superset_dashboards_export_20260518_231338.zip
!infrastructure/superset/exports/superset_datasources_export_20260518_231344.yaml

# ==========================================
# 6. EXCEÇÕES (O QUE DEVE SER VERSIONADO)
# ==========================================
# Mantém a estrutura de pastas de dados no Git (requer criar um arquivo .gitkeep vazio nelas)
!data/geo/.gitkeep
!data/processed/.gitkeep
!data/raw/.gitkeep
!data/results/.gitkeep

# Força o Git a aceitar os arquivos JSON do Druid e exports atuais do Superset
!infrastructure/druid_specs/*.json
!infrastructure/superset/*.zip
!infrastructure/superset/exports/
